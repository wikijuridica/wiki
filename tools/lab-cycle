#!/bin/sh
set -eu

export GOCACHE="${GOCACHE:-/tmp/opt-wiki-go-cache}"

run_step() {
	name="$1"
	shift
	start="$(date +%s)"
	printf 'TIMING start %s\n' "$name"
	if "$@"; then
		status=0
	else
		status="$?"
	fi
	end="$(date +%s)"
	elapsed="$((end - start))"
	if [ "$status" -eq 0 ]; then
		printf 'TIMING pass %s seconds=%s\n' "$name" "$elapsed"
	else
		printf 'TIMING fail %s seconds=%s status=%s\n' "$name" "$elapsed" "$status"
	fi
	return "$status"
}

run_step go-test-all go test -count=1 ./...
run_step check-all-contracts go run ./cmd/check all
run_step generate-batch-drafts ./tools/generate-batch-drafts --samples-per-batch 10 --checked-at 2026-06-09
run_step lab-term-draft ./tools/lab-term-draft
run_step lab-content-quality ./tools/lab-content-quality
run_step build-public go run ./cmd/build public
run_step go-list-modules go list -m all
run_step diff-check git diff --check
run_step python-residue find . -name '*.py' -o -name '*.pyc'
